# build output
/bin/
/velexa-sim-me
/velexa-sim-me.*
/matching-engine

# local backups and old binaries
/backups/
*.bak
*.bak.*

# runtime state written next to the binary on a dev machine
data/
/instruments.json
admin_audit.jsonl
me.env

# logs (the FIX message log can reach gigabytes)
/logs/
*.log
fix_messages.log

# state files that unit tests write next to the package under test
/internal/**/data/
