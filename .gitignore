# build output
/bin/
/velexa-sim-me
/velexa-sim-me.*
/matching-engine

# local backups and old binaries
/backups/
*.bak
*.bak.*

# runtime state written next to the binary on a dev machine
data/
/instruments.json
admin_audit.jsonl
me.env

# logs (the FIX message log can reach gigabytes)
/logs/
*.log
fix_messages.log

# state files that unit tests write next to the package under test
/internal/**/data/

# credentials and contacts: never commit (see the *.example files)
deploy/state/fix_brokers.json
deploy/state/itch_brokers.json
deploy/state/broker_meta.json
deploy/state/fix_allow.json
session.key
initial-admin-password
users.json

# docker system-test work folders (tools/docker-e2e.sh)
.docker-e2e.*
# docker compose settings (secrets)
.env

# Air live-reload build output and Go caches (make dev)
/tmp/
