# Settings for docker compose. tools/docker-setup.sh (make docker-setup) writes
# .env from this with real values; keep .env private (mode 0600, git-ignored).

# ── Host side ────────────────────────────────────────────────────────────────
DOCKER_BIND=0.0.0.0            # 127.0.0.1 to reach the engine only from this host / a local proxy
DOCKER_HTTP_PORT=8010          # web console, API, WebSockets
DOCKER_FIX_PORT=5001           # FIX acceptor
DOCKER_ITCH_PORT=5501          # ITCH market feed
DOCKER_ITCH_INDEX_PORT=5502
DOCKER_ITCH_NEWS_PORT=5503
DOCKER_DATA_DIR=./data         # brokers, allowlist, order-book ids, FIX log, instruments
DOCKER_UID=                    # the engine runs as this user (it must own DOCKER_DATA_DIR); setup fills it
DOCKER_GID=
ME_VERSION=dev                 # image tag

# ── Database (the db service) ────────────────────────────────────────────────
DB_PASSWORD=
# ME_DB_URL=postgres://user:pass@other-host:5432/velexa_me?sslmode=require   # an external database instead

# ── Engine ───────────────────────────────────────────────────────────────────
ME_PUB_IP=                     # the host's IP: what broker sheets tell brokers to connect to
ME_INT_IP=
ME_ADMIN_USER=
ME_ADMIN_PASS=
ME_ADMIN_SECRET=
# Any other engine setting from me.env.example can be added here, e.g.
# ME_FIX_AUTH=on
# ME_COOKIE_SECURE=on
# ME_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
# FIX_SENDER=DSEME
